@charset "utf-8";

body { --play-button-size: 30px; --cmp-play-button-width: var(--play-button=
-size) !important; --cmp-play-button-height: var(--play-button-size) !impor=
tant; }

.inline-player { --brand-active: #E60019; --text-color: #767676; }

.fab-view:has(.inline-player) .trinity-player-wrapper { border-radius: var(=
--play-button-size) !important; width: var(--play-button-size) !important; =
height: var(--play-button-size) !important; }

.section-container { display: flex; align-items: center; gap: 16px; margin:=
 8px; box-sizing: border-box; position: relative; width: 100%; }

.section-left, .section-right { display: flex; align-items: center; gap: 12=
px; flex: 1 1 0%; }

.section-right { justify-content: flex-end; }

.progress-wrapper { display: flex; align-items: center; flex: 1 1 0%; posit=
ion: relative; }

.inline-player .cmp-el-vue-progress-bar .track .passed { background: var(--=
brand-active) !important; }

.inline-player .cmp-el-play-button { flex-shrink: 0; }

.inline-player .title-container {
  display: flex; align-items: center; justify-content: space-between; gap: =
5px;
  & .cmp-el-title .title { margin: 0px; width: 100%; display: block; color:=
 var(--text-color); font-size: 14px; }
  & .dot { display: inline-block; width: 3px; height: 3px; border-radius: 5=
0%; background: var(--text-color); vertical-align: middle; }
  & .cmp-el-approx-time .approximate-time { font-size: 14px; color: var(--t=
ext-color); }
}

.inline-player .cmp-el-progress-bar { flex: 1 1 0%; margin: 0px; }

.inline-player .cmp-el-timer {
  width: 35px;
  &.timer-right { text-align: right; }
  & .timer { color: var(--text-color); font-size: 10px; }
}

